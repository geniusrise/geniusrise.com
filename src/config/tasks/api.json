{
    "type": "object",
    "properties": {
        "model_name": {
            "type": "string"
        },
        "model_class": {
            "type": "string",
            "default": "AutoModelForCausalLM"
        },
        "tokenizer_class": {
            "type": "string",
            "default": "AutoTokenizer"
        },
        "use_cuda": {
            "type": "boolean",
            "default": false
        },
        "precision": {
            "type": "string",
            "default": "float16"
        },
        "quantization": {
            "type": "integer",
            "default": 0
        },
        "device_map": {
            "oneOf": [
                {
                    "type": "string"
                },
                {
                    "type": ["object", "null"]
                }
            ],
            "default": "auto"
        },
        "max_memory": {
            "type": "object",
            "default": null
        },
        "torchscript": {
            "type": "boolean",
            "default": true
        },
        "endpoint": {
            "type": "string",
            "default": "*"
        },
        "port": {
            "type": "integer",
            "default": 3000
        },
        "cors_domain": {
            "type": "string",
            "default": "http://localhost:3000"
        },
        "username": {
            "type": ["string", "null"]
        },
        "password": {
            "type": ["string", "null"]
        },
        "model_args": {
            "type": "object",
            "additionalProperties": true
        }
    },
    "required": ["model_name"],
    "additionalProperties": false
}
